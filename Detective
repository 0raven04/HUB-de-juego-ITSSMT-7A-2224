import javax.swing.*;
import java.awt.*;
import java.awt.event.*;
import java.io.File;
import javax.sound.sampled.*;

public class DetectiveGUIDeluxe {

    static class Nodo {
        String dato;
        Nodo si, no;

        Nodo(String dato) {
            this.dato = dato;
        }

        boolean esHoja() {
            return si == null && no == null;
        }
    }

    Nodo raiz;
    Nodo actual;

    JFrame ventana;
    JLabel pregunta;
    JButton botonSi, botonNo;

    public DetectiveGUIDeluxe() {
        construirArbol();
        actual = raiz;
        crearInterfaz();
    }

    private void construirArbol() {
        raiz = new Nodo("¿Es una película de acción?");

        raiz.si = new Nodo("¿Tiene escenas de carreras de autos?");
        raiz.no = new Nodo("¿Es una película de romance?");

        raiz.si.si = new Nodo("Rápidos y Furiosos");
        raiz.si.no = new Nodo("John Wick");

        raiz.no.si = new Nodo("¿La película trata sobre una enfermedad grave?");
        raiz.no.no = new Nodo("¿Es una película de terror?");

        raiz.no.si.si = new Nodo("¿El personaje principal tiene cáncer?");
        raiz.no.si.no = new Nodo("¿Hay un accidente que cambia la vida?");

        raiz.no.si.si.si = new Nodo("Bajo la Misma Estrella");
        raiz.no.si.si.no = new Nodo("Five Feet Apart");

        raiz.no.si.no.si = new Nodo("¿El protagonista queda en silla de ruedas?");
        raiz.no.si.no.no = new Nodo("¿Es sobre segundas oportunidades?");

        raiz.no.si.no.si.si = new Nodo("Yo Antes de Ti");
        raiz.no.si.no.si.no = new Nodo("Si Decidieran Quedarse");

        raiz.no.si.no.no.si = new Nodo("Como si fuera la primera vez");
        raiz.no.si.no.no.no = new Nodo("Amor de Medianoche");

        raiz.no.no.si = new Nodo("¿Tiene fantasmas?");
        raiz.no.no.no = new Nodo("¿Es una película animada?");

        raiz.no.no.si.si = new Nodo("El Conjuro");
        raiz.no.no.si.no = new Nodo("It");

        raiz.no.no.no.si = new Nodo("¿Tiene personajes que cantan?");
        raiz.no.no.no.no = new Nodo("¿Es una película de ciencia ficción?");

        raiz.no.no.no.si.si = new Nodo("Frozen");
        raiz.no.no.no.si.no = new Nodo("Toy Story");

        raiz.no.no.no.no.si = new Nodo("Star Wars");
        raiz.no.no.no.no.no = new Nodo("Forrest Gump");
    }

    private void crearInterfaz() {
        ventana = new JFrame("🎬 Detective de Películas — Deluxe Edition");
        ventana.setSize(700, 400);
        ventana.setDefaultCloseOperation(JFrame.EXIT_ON_CLOSE);
        ventana.setLocationRelativeTo(null);

        JPanel panelFondo = new JPanel();
        panelFondo.setBackground(new Color(30, 30, 50));
        panelFondo.setLayout(new BorderLayout());

        pregunta = new JLabel(actual.dato, SwingConstants.CENTER);
        pregunta.setFont(new Font("Segoe UI", Font.BOLD, 24));
        pregunta.setForeground(Color.WHITE);

        botonSi = crearBoton("Sí", new Color(0, 200, 120));
        botonNo = crearBoton("No", new Color(220, 60, 60));

        JPanel panelBotones = new JPanel();
        panelBotones.setOpaque(false);
        panelBotones.add(botonSi);
        panelBotones.add(botonNo);

        panelFondo.add(pregunta, BorderLayout.CENTER);
        panelFondo.add(panelBotones, BorderLayout.SOUTH);

        ventana.add(panelFondo);
        ventana.setVisible(true);

        botonSi.addActionListener(e -> procesarRespuesta("si"));
        botonNo.addActionListener(e -> procesarRespuesta("no"));
    }

    private JButton crearBoton(String texto, Color color) {
        JButton b = new JButton(texto);
        b.setFont(new Font("Segoe UI", Font.BOLD, 18));
        b.setForeground(Color.WHITE);
        b.setBackground(color);
        b.setFocusPainted(false);
        b.setBorder(BorderFactory.createEmptyBorder(10, 20, 10, 20));

        b.addMouseListener(new MouseAdapter() {
            public void mouseEntered(MouseEvent e) {
                b.setBackground(color.darker());
            }
            public void mouseExited(MouseEvent e) {
                b.setBackground(color);
            }
        });

        return b;
    }

    private void reproducirSonido() {
        try {
            File archivo = new File("click.wav");
            Clip clip = AudioSystem.getClip();
            clip.open(AudioSystem.getAudioInputStream(archivo));
            clip.start();
        } catch (Exception e) {
            System.out.println("No se pudo reproducir el sonido.");
        }
    }

    private void procesarRespuesta(String respuesta) {
        reproducirSonido();

        if (!actual.esHoja()) {
            actual = respuesta.equals("si") ? actual.si : actual.no;
            animarTexto(actual.dato);
        } else {
            int opcion = JOptionPane.showConfirmDialog(
                    ventana,
                    "¿La película es: " + actual.dato + "?",
                    "🎬 Resultado",
                    JOptionPane.YES_NO_OPTION
            );

            if (opcion == JOptionPane.YES_OPTION) {
                JOptionPane.showMessageDialog(
                        ventana,
                        "🎉 ¡Adiviné tu película!",
                        "¡Genial!",
                        JOptionPane.INFORMATION_MESSAGE
                );
                System.exit(0);
            } else {
                JOptionPane.showMessageDialog(
                        ventana,
                        "😢 No la acerté, ¡intentemos otra vez!",
                        "Fallé",
                        JOptionPane.WARNING_MESSAGE
                );

                actual = raiz;
                animarTexto(actual.dato);
            }
        }
    }

    private void animarTexto(String nuevoTexto) {
        pregunta.setText("");
        Timer timer = new Timer(30, null);
        final int[] index = {0};

        timer.addActionListener(e -> {
            if (index[0] < nuevoTexto.length()) {
                pregunta.setText(pregunta.getText() + nuevoTexto.charAt(index[0]));
                index[0]++;
            } else {
                timer.stop();
            }
        });
        timer.start();
    }

    public static void main(String[] args) {
        new DetectiveGUIDeluxe();
    }
}
